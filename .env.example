# Variable reference only. All optional for local preview.
# Supply secrets through the process environment; keep API keys out of files.
PORT=8080
ADMIN_PASSWORD=
SESSION_SECRET=
# From cloud.higgsfield.ai -> API keys. Either HF_KEY="id:secret" or the pair below.
HF_KEY=
HF_API_KEY=
HF_API_SECRET=
HF_BASE_URL=https://api.higgsfield.ai
# Public https origin; enables Higgsfield completion webhooks (polling works without it)
PUBLIC_URL=
